# --- Model -------------------------------------------------------------
# demo = rule-based stand-in, no key needed. openai_compat = any OpenAI-compatible API.
LLM_PROVIDER=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=
# Gemini via its OpenAI-compatible endpoint:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Cost tracking, USD per 1M tokens (written to the turns table)
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0

# --- Storage -----------------------------------------------------------
# Empty = in-memory (forgets on restart). docker compose sets this for you.
DATABASE_URL=

# --- Behaviour ---------------------------------------------------------
DEFAULT_LANGUAGE=hebrew
BUSINESS_TIMEZONE=Asia/Jerusalem
HISTORY_MESSAGES=20
MAX_REPLY_CHARS=700

# --- API / WhatsApp ----------------------------------------------------
# Bearer token for /v1/*. Leave empty only for local development.
API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
